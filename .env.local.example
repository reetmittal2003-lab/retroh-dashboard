# Connect the dashboard to your live Netlify Forms submissions.
# Without these, the dashboard shows sample data.

# Netlify personal access token: https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_ACCESS_TOKEN=

# The Site ID for the retroh site (Site settings > General > Site details > Site ID)
NETLIFY_SITE_ID=

# Shared password required to view the dashboard (HTTP Basic Auth via proxy.ts).
# Required — without it the dashboard refuses all requests (503).
DASHBOARD_PASSWORD=

# Executive dashboard report embeds (all optional — each section shows a
# "not connected" empty state until its URL is set). No Google Cloud project,
# service account, or billing is required for any of these.

# Public "Anyone with the link" embed URL for a Looker Studio report built on
# a Google Analytics 4 property. Powers the Website Traffic tab.
NEXT_PUBLIC_GA4_LOOKER_URL=

# Public "Anyone with the link" embed URL for a Looker Studio report built on
# a Google Search Console property. Powers the SEO tab.
NEXT_PUBLIC_GSC_LOOKER_URL=

# Microsoft Clarity project URL for Session Recordings. Powers the
# "Open Session Recordings" button on the User Behavior tab.
NEXT_PUBLIC_CLARITY_RECORDINGS_URL=

# Microsoft Clarity project URL for Heatmaps. Powers the "Open Heatmaps"
# button on the User Behavior tab.
NEXT_PUBLIC_CLARITY_HEATMAPS_URL=

# New-lead push notifications: Netlify's outgoing webhook (submission_created)
# posts to /api/notify/netlify-lead?secret=<NETLIFY_WEBHOOK_SECRET>, which
# relays a formatted push to ntfy.sh. Without these, the route returns 401/500.

# Shared secret the webhook URL must include as ?secret=... — prevents
# random internet traffic from spamming your phone.
NETLIFY_WEBHOOK_SECRET=

# Private ntfy.sh topic name (e.g. retroh-leads-xxxxxxxx). Subscribe to
# https://ntfy.sh/<topic> in the ntfy app (phone) or browser (laptop) to
# receive pushes.
NTFY_TOPIC=
