# Connect the dashboard to your live Netlify Forms submissions.
# Without these, the dashboard shows sample data.

# Netlify personal access token: https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_ACCESS_TOKEN=

# The Site ID for the retroh site (Site settings > General > Site details > Site ID)
NETLIFY_SITE_ID=

# Shared password required to view the dashboard (HTTP Basic Auth via proxy.ts).
# Required — without it the dashboard refuses all requests (503).
DASHBOARD_PASSWORD=
